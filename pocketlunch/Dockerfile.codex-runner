FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git bash ripgrep curl jq \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @openai/codex

ENV HOME=/codex-home \
    NPM_CONFIG_CACHE=/codex-home/.npm \
    NPM_CONFIG_PREFIX=/codex-home/.npm-global \
    PATH=/codex-home/.npm-global/bin:$PATH

RUN mkdir -p /workspace/context /codex-home/.npm /codex-home/.npm-global \
    && chown -R node:node /workspace /codex-home

USER node
WORKDIR /workspace/context

CMD ["sh", "-lc", "sleep infinity"]
